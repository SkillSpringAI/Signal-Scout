{
  "name": "signal-scout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "verify:firestore": "tsx server/firestoreProbe.ts",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
